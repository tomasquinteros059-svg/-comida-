# Lo único que hace: poner HTTPS adelante de comeIA.
#
# Caddy pide el certificado a Let's Encrypt la primera vez y lo renueva solo.
# No hay nada que configurar ni que renovar a mano.
{$DOMINIO} {
	# El panel, el chat y el webhook de WhatsApp: todo es el mismo proceso.
	reverse_proxy comeia:3000

	# Meta manda el cuerpo del webhook y lo firma: si algo lo tocara en el
	# camino, la firma no coincidiría. Caddy no lo toca, pero se deja dicho.
	encode gzip

	log {
		output file /data/acceso.log
		format console
	}
}
