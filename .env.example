# ── Servidor ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Base de datos ───────────────────────────────────────────────────────────
# Ruta del archivo SQLite. Se crea solo la primera vez.
DATABASE_PATH=./data/comeia.db

# ── Chatbot (Anthropic) ─────────────────────────────────────────────────────
# Sin esta clave el bot funciona igual, pero en "modo determinista":
# entiende pedidos con reglas y coincidencia difusa en vez de un LLM.
ANTHROPIC_API_KEY=

# Modelo del chat. Ver la tabla de costos por pedido en DEPLOY.md.
#   claude-opus-5    el mejor, ~$0,09 por pedido
#   claude-sonnet-5  muy bueno, ~$0,04 por pedido
CHAT_MODEL=claude-opus-5

# Cuánto "piensa" antes de responder: low | medium | high | xhigh | max.
# Tomar un pedido es simple y el cliente está esperando, así que "low" responde
# más rápido y más barato. Subilo si la carta tiene muchas variantes.
CHAT_EFFORT=low

# ── Panel ───────────────────────────────────────────────────────────────────
# El panel se usa con usuario y clave: cada persona del local tiene el suyo y
# ve solo lo que le toca según su rol. El primer dueño se da de alta desde la
# pantalla de entrada la primera vez que se abre el panel.
#
# ADMIN_TOKEN cumple dos funciones:
#   1. Autoriza esa alta inicial. Sin esto, el primero que encuentra la
#      dirección de un panel recién instalado se queda con el local.
#   2. Es la llave de repuesto: sirve para entrar si el dueño se queda afuera.
# Guardalo donde guardarías la llave del local, no en el grupo de WhatsApp.
#
# Vacío = sin auth, y SOLO sirve para desarrollo: con NODE_ENV=production el
# proceso se niega a arrancar sin esto.
#   openssl rand -base64 32
ADMIN_TOKEN=

# Intentos de ingreso por minuto para un mismo usuario. Por encima de esto se
# corta un minuto. El techo por conexión es ocho veces este número, para que el
# que se equivoca escribiendo no deje afuera al resto del turno.
LOGIN_RATE_MAX=5

# ── Red (solo producción) ───────────────────────────────────────────────────
# Saltos de proxy en los que confiar para leer la IP real del cliente.
# 1 si hay un nginx/Caddy/Traefik adelante; 0 si el proceso mira a internet
# directo (si no, cualquiera falsea su IP y esquiva el límite de pedidos).
TRUST_PROXY=0

# Orígenes que pueden llamar a la API desde otro dominio, separados por coma.
# Vacío = solo el mismo origen, que es lo normal: el panel se sirve desde acá.
ALLOWED_ORIGINS=

# Límite del chat, que es la única ruta pública y la que cuesta plata.
CHAT_RATE_WINDOW_MS=60000
CHAT_RATE_MAX=20

# ── Local ───────────────────────────────────────────────────────────────────
CURRENCY=ARS
TIMEZONE=America/Argentina/Buenos_Aires

# ── WhatsApp (opcional) ─────────────────────────────────────────────────────
# El canal que de verdad usa la gente. El motor del chat es el mismo: toma el
# pedido igual venga del web o de WhatsApp.
#
# Se saca de la app de WhatsApp Business en developers.facebook.com. Va por
# variables de entorno y NO en la base a proposito: la base se respalda, y esas
# copias terminan circulando. Un token adentro de un backup que anda dando
# vueltas deja mandar mensajes en nombre del local.
#
# El webhook se da de alta apuntando a:  https://tu-dominio/api/whatsapp
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
# La inventas vos y la pegas igual en Meta al dar de alta el webhook.
WHATSAPP_VERIFY_TOKEN=
# Con esto se firma cada llamada. Sin esto, cualquiera que sepa la URL simula
# un cliente y le hace tomar pedidos falsos al local.
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# ── Cobros (opcional) ───────────────────────────────────────────────────────
# Cobrar a mano —efectivo, debito, transferencia— funciona sin configurar nada,
# y es la mayoria de lo que pasa en un mostrador. Esto es solo para los links de
# pago de Mercado Pago, para el que pide por el chat y paga antes de pasar.
#
# Se saca de mercadopago.com.ar/developers. Por entorno y no en la base, por lo
# mismo que WhatsApp: la base se respalda y esas copias circulan.
MERCADOPAGO_ACCESS_TOKEN=
# Con esto se verifica que el aviso de pago lo mando Mercado Pago. Sin esto,
# cualquiera que sepa la URL manda un "pagado" y se lleva la comida gratis.
MERCADOPAGO_WEBHOOK_SECRET=
# La direccion publica del local: adonde vuelve el cliente despues de pagar y
# adonde Mercado Pago manda el aviso.
PUBLIC_URL=
